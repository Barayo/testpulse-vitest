{
  "name": "testpulse-vitest",
  "version": "1.0.4",
  "description": "Vitest reporter + check CLI for reporting test results into TestPulse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barayo/testpulse-vitest.git"
  },
  "homepage": "https://github.com/Barayo/testpulse-vitest#readme",
  "bugs": "https://github.com/Barayo/testpulse-vitest/issues",
  "keywords": [
    "vitest",
    "vitest-reporter",
    "testpulse",
    "junit",
    "test-management"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "testpulse-vitest": "dist/bin/check.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --selectProjects unit",
    "test:e2e": "npm run build && jest --selectProjects e2e",
    "test:all": "npm run build && jest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@vitest/runner": "^3.2.7",
    "jest": "^29.7.0",
    "semantic-release": "^24.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
